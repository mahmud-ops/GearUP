model Users {
  id       String @id @default(uuid())
  name     String
  email    String @unique()
  password String
  role     Role   @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  gearItems    GearItems[]
  rentalOrders Rental_orders[]
  reviews      Reviews[]
  payments     Payment[]
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}
