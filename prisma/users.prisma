model Users {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique()
  password String
  role     Role       @default(CUSTOMER)
  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  gearItems        GearItems[]
  customerOrders   Rental_orders[] @relation("CustomerOrders")
  providerOrders   Rental_orders[] @relation("ProviderOrders")
  reviews          Reviews[]
  customerPayments Payment[]       @relation("PaymentCustomer")
  providerPayments Payment[]       @relation("PaymentProvider")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
