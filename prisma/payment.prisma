enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Payment {
  id String @id @default(uuid())

  customerId String
  customer   Users  @relation("PaymentCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  orderId String @unique
  order   Rental_orders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  providerId String
  provider   Users  @relation("PaymentProvider", fields: [providerId], references: [id], onDelete: Cascade)

  stripeSessionId String @unique

  transactionId String? @unique

  amount Decimal @db.Decimal(10, 2)

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
