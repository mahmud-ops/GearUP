enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Payment {
  id String @id @default(uuid())

  orderId String
  order   Rental_orders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  providerId String
  provider   Users  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  stripeSessionId String

  transactionId String @unique

  amount Decimal @db.Decimal(10, 2)

  status PaymentStatus @default(PENDING)

  paidAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
